# =============================================================================
#  TurtleBot3 Motion Server - environment configuration (TEMPLATE)
#  ---------------------------------------------------------------------------
#  Copy this file to ".env" and fill in your real values:
#       cp .env.example .env
#  The real .env is git-ignored so secrets never reach GitHub.
# =============================================================================

# --- Network -----------------------------------------------------------------
ROBOT_IP=192.168.x.x            # IP address of the TurtleBot3
LAPTOP_IP=192.168.x.x           # IP address of this laptop

# --- Robot SSH login ---------------------------------------------------------
ROBOT_USER=ubuntu
ROBOT_PASSWORD=changeme         # <-- your robot's SSH password

# --- ROS 2 -------------------------------------------------------------------
# Both robot and laptop MUST use the same ROS_DOMAIN_ID to see each other.
ROS_DOMAIN_ID=203
TURTLEBOT3_MODEL=burger         # burger | waffle | waffle_pi
LDS_MODEL=LDS-01                # LDS-01 | LDS-02  (your lidar model)

# --- Topics ------------------------------------------------------------------
IMAGE_TOPIC=/image/compressed
IMAGE_TYPE=compressed           # compressed | raw | auto
CMD_VEL_TOPIC=/cmd_vel
ODOM_TOPIC=/odom                # read to measure distance and angle goals
SCAN_TOPIC=/scan                # lidar; how "go to the bottle" knows when to stop

# --- Motion server -----------------------------------------------------------
MAX_LIN=0.22                    # max linear speed  (Burger 0.22, Waffle 0.26)
MAX_ANG=2.84                    # max angular speed (Burger 2.84, Waffle 1.82)
SERVER_PORT=8000

# --- Natural-language control (local LLM) ------------------------------------
# Type "move forward 1 meter" instead of holding a key. Needs ollama running
# locally with the model below already pulled.
ENABLE_NL=1                     # 1 to enable, 0 to disable
LLM_URL=http://localhost:11434  # ollama base URL
LLM_MODEL=qwen2.5:3b            # model used to parse commands

# Hard caps. The model only interprets your words; these are enforced in code,
# so a misread ("3 hours") can never become a long or far motion.
NL_MAX_DURATION=10              # seconds, per typed motion
NL_MAX_DISTANCE=2.0             # meters,  per typed distance goal
NL_MAX_ANGLE=360                # degrees, per typed angle goal
GOAL_TIMEOUT_MAX=60             # seconds; ceiling on a closed-loop goal's
                                # timeout backstop, so a slipping wheel or dead
                                # odometry can never mean "drive forever"

# Chained commands ("forward 0.5 m, turn right 90 degrees, forward 0.3 m").
# The caps above are per STEP, so these bound the whole sequence -- otherwise
# three 2 m legs would pass every check and drive 6 m. A sequence exceeding any
# of these is refused outright rather than trimmed to fit.
NL_MAX_STEPS=5                  # steps per sequence
NL_MAX_CHAIN_DISTANCE=3.0       # meters of total PATH LENGTH (not displacement:
                                # "forward 2 m, back 2 m" spends 4 m of budget)
NL_MAX_CHAIN_ANGLE=720          # degrees of total rotation
NL_MAX_CHAIN_SECONDS=120        # worst-case running time for one sequence

# --- Visual seek: "go to the bottle" -----------------------------------------
# Rotate until the camera finds the named object, turn to face it, drive at it,
# stop short of it. The LLM only extracts the object's NAME; finding it is an
# object detector and the stopping distance is measured by the lidar.
#
# Needs YOLO-World weights (open-vocabulary, so the object doesn't have to be
# one of a fixed list) and a working /scan. Detection runs on the GPU if there
# is one: ~19 ms/frame on an RTX 3060, ~10x slower on CPU, which is too slow to
# steer with.
ENABLE_SEEK=0                   # 1 to enable
SEEK_WEIGHTS=yolov8m-world.pt   # path to YOLO-World weights
SEEK_DEVICE=                    # blank = cuda if available, else cpu; or 0 / cpu
SEEK_CONF=0.10                  # detection threshold. Far below the usual 0.25
                                # because this camera is dim: measured live, a
                                # chair in plain view scored 0.13-0.24 while
                                # absent objects stayed under 0.07. At 0.25 the
                                # robot sees no furniture at all. False positives
                                # are held off by requiring the object in 2 of 3
                                # consecutive frames, not by this number.
                                # Re-measure with /detect if your room is brighter
SEEK_STOP_DISTANCE=0.35         # meters to stop short of the target (min 0.25;
                                # below the lidar's 0.12 m floor it reads a
                                # dropout, so too small means stopping BLIND)
SEEK_MAX_TRAVEL=2.5             # meters one approach may drive before giving up
                                # (the LDS-01 only sees 3.5 m at all)
SEEK_SEARCH_STEP=25             # degrees turned between looks while searching.
                                # Small because the camera is mounted rotated,
                                # so its horizontal field of view is the NARROW
                                # axis -- big steps look straight past things
SEEK_SEARCH_MAX=400             # degrees swept before reporting "not found"
SEEK_TIMEOUT=60                 # seconds for one whole seek

# NOTE: the lidar only sees its own scan plane (~18 cm up). An object on a table
# is detected by the camera but returns no range, and the approach refuses to
# drive rather than guess. Floor-level objects are what this is built for.
